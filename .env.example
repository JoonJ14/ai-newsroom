# AI Newsroom — Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ─── Supabase (required) ─────────────────────────────────────
# Get these from your Supabase project dashboard: Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Read-only (public) key: enough for `npm run preview:editor` and `npm run digest -- --preview`
SUPABASE_ANON_KEY=

# ─── Digest Delivery (pick one adapter) ──────────────────────

# Discord
DISCORD_WEBHOOK_URL=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Slack
SLACK_WEBHOOK_URL=

# iMessage (macOS only — use phone number or Apple ID email)
IMESSAGE_RECIPIENT=

# ─── Optional ────────────────────────────────────────────────

# Claude API key, for local runs: the AI editor (`npm run editor`,
# `npm run preview:editor -- --dry-run`), the digest's repeat check in
# `npm run digest -- --preview`, and the summary at the top of a fallback digest.
# All three use one client (src/editor/client.ts). On GitHub Actions the hosted
# project uses workload identity federation and has no key; a fork can set up
# federation (docs/editor.md) or use an ANTHROPIC_API_KEY repository secret.
ANTHROPIC_API_KEY=

# AI editor settings (all optional; defaults in docs/editor.md)
# EDITOR_MODEL=claude-haiku-5-5
# EDITOR_EFFORT=low
# EDITOR_MAX_ITEMS=300
# EDITOR_MAX_CALLS=20

# Digest layout and thresholds (all optional; defaults in docs/digest.md).
# On GitHub Actions these are repository variables.
# DIGEST_LAYOUT=plain            # plain | embeds (Discord)
# DIGEST_TOP_MIN_IMPORTANCE=6
# DIGEST_MIN_JUDGED_SHARE=0.5    # below this share judged, the old ranking is used
# DIGEST_TOP_WEAK_SOURCE_MIN_IMPORTANCE=8  # a story without a strong source leads only at this rating
# DIGEST_MAX_PER_OUTLET=2        # stories per section with the same lead outlet
# DIGEST_REPEAT_EFFORT=medium    # the repeat check's effort (it uses ANTHROPIC_API_KEY or federation)

# Retention (all optional; on GitHub Actions, repository variables; docs/DECISIONS.md, DEC-020).
# Every item is kept 90 days; items the AI editor rated this low or lower are deleted sooner.
# CLEANUP_LOW_IMPORTANCE_MAX=2   # 0 switches the rule off
# CLEANUP_LOW_IMPORTANCE_DAYS=14 # 8 to 90

# GitHub token — higher rate limits for GitHub API collectors
GITHUB_TOKEN=
