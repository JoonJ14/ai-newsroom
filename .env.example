# AI Newsroom — Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ─── Supabase (required) ─────────────────────────────────────
# Get these from your Supabase project dashboard: Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Read-only (public) key: enough for `npm run preview:editor`
SUPABASE_ANON_KEY=

# ─── Digest Delivery (pick one adapter) ──────────────────────

# Discord
DISCORD_WEBHOOK_URL=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Slack
SLACK_WEBHOOK_URL=

# iMessage (macOS only — use phone number or Apple ID email)
IMESSAGE_RECIPIENT=

# ─── Optional ────────────────────────────────────────────────

# Claude API key — the AI editor (`npm run editor`, `npm run preview:editor -- --dry-run`)
# and the AI-generated summary at the top of each digest. On GitHub Actions the editor
# can use workload identity federation instead (docs/editor.md).
ANTHROPIC_API_KEY=

# AI editor settings (all optional; defaults in docs/editor.md)
# EDITOR_MODEL=claude-haiku-5-5
# EDITOR_EFFORT=low
# EDITOR_MAX_ITEMS=300
# EDITOR_MAX_CALLS=20

# GitHub token — higher rate limits for GitHub API collectors
GITHUB_TOKEN=
